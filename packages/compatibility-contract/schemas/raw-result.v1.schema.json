{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rsvite:compatibility:raw-result:v1",
  "title": "rsvite compatibility raw result, version 1",
  "description": "One measured run of one corpus entry under one subject. Raw results are the unit the M0 exit criteria are read from, so every field they name is required here rather than reconstructed later.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "manifestEntry",
    "subject",
    "environment",
    "command",
    "startedAt",
    "finishedAt",
    "outcome",
    "javascriptApiLevel",
    "capabilityOwner",
    "explicitFallbacks"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "manifestEntry": {
      "$ref": "#/$defs/manifestEntryRef"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "command": {
      "$ref": "#/$defs/command"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "description": "The correctness result. It is required, so a run that only produced timings cannot be filed as evidence.",
      "enum": ["pass", "fail"]
    },
    "javascriptApiLevel": {
      "description": "The JavaScript API level this run actually exercised and the subject supported for it. It can be lower than the level the corpus entry declares — an entry declared at C1 measured against a subject that only supports C0 records C0 here — so the level a result was obtained at is never inferred from the corpus.",
      "enum": ["C0", "C1", "C2", "C3"]
    },
    "firstIncompatibleBehavior": {
      "$ref": "#/$defs/firstIncompatibleBehavior"
    },
    "failureClassification": {
      "$ref": "#/$defs/failureClassification"
    },
    "capabilityOwner": {
      "description": "Who executed the behavior under measurement. Required, because a result with unknown ownership cannot support a Rust-first claim.",
      "enum": ["rust", "compatibility-javascript"]
    },
    "explicitFallbacks": {
      "description": "Every fallback the run relied on. An empty array asserts there were none; an undeclared fallback invalidates the result.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/explicitFallback"
      }
    },
    "browserErrors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/browserError"
      }
    },
    "measurements": {
      "$ref": "#/$defs/measurements"
    },
    "artifactPaths": {
      "description": "Paths to preserved evidence produced by this run, relative to the result file.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "fail"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "firstIncompatibleBehavior": {
            "$ref": "#/$defs/firstIncompatibleBehavior"
          },
          "failureClassification": {
            "$ref": "#/$defs/failureClassification"
          }
        },
        "required": ["firstIncompatibleBehavior", "failureClassification"]
      }
    }
  ],
  "$defs": {
    "manifestEntryRef": {
      "description": "Which corpus entry produced this result, restated with the exact source commit so a result stays interpretable on its own.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceCommit"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 64
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "subject": {
      "description": "What was measured: the original Vite baseline or rsvite.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "enum": ["vite", "rsvite"]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "environment": {
      "description": "Everything a comparison must hold constant between the Vite baseline and rsvite.",
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "runnerImage", "nodeVersion", "packageManager"],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "runnerImage": {
          "type": "string",
          "minLength": 1
        },
        "nodeVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"
        },
        "packageManager": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "enum": ["pnpm", "npm", "yarn", "bun"]
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"
            }
          }
        },
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "exitCode": {
          "type": ["integer", "null"]
        }
      }
    },
    "firstIncompatibleBehavior": {
      "description": "The first behavior that diverged, not a summary of everything that failed afterwards.",
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "message"],
      "properties": {
        "phase": {
          "enum": ["install", "dev", "build", "preview", "test", "browser"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "evidencePath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "failureClassification": {
      "description": "Why this failure matters, decided per the compatibility record rather than left to the reader.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "evidence"],
      "properties": {
        "kind": {
          "enum": [
            "current-compatibility-requirement",
            "justified-low-priority-gap",
            "test-coupled-to-vite-internals"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "explicitFallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "reason"],
      "properties": {
        "component": {
          "enum": [
            "vite-dev-server",
            "vite-build-orchestration",
            "vite-module-graph",
            "vite-scheduler",
            "other"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "browserError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": {
          "enum": ["console-error", "page-error", "request-failure"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "measurements": {
      "description": "Pilot measurement data. Cache state and run order are required alongside the numbers, because a timing without them cannot be compared or turned into a variation estimate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["wallClockMs", "maxRssBytes", "cacheState", "runOrder"],
      "properties": {
        "wallClockMs": {
          "type": "number",
          "minimum": 0
        },
        "maxRssBytes": {
          "description": "Peak resident set size of the measured process tree, counted once per process.",
          "type": "integer",
          "minimum": 0
        },
        "cacheState": {
          "enum": ["cold", "warm"]
        },
        "runOrder": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "extensions": {
      "description": "Adapter-owned data, namespaced so an adapter never has to widen the core result shape.",
      "type": "object",
      "propertyNames": {
        "pattern": "^x-[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
