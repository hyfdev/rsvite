{
  "contractVersion": 1,
  "entries": [
    {
      "id": "vite-upstream-html-preserve-comments",
      "kind": "vite-upstream-e2e",
      "source": {
        "repository": "https://github.com/vitejs/vite",
        "commit": "ee644014aab61e546742b862a7d7b0d6c7d67a7b",
        "license": {
          "spdxId": "MIT",
          "path": "LICENSE"
        }
      },
      "lockfile": {
        "path": "pnpm-lock.yaml",
        "packageManager": {
          "name": "pnpm",
          "version": "10.34.5"
        }
      },
      "commands": {
        "install": {
          "argv": ["pnpm", "install", "--frozen-lockfile"]
        },
        "test": {
          "argv": [
            "pnpm",
            "test-serve",
            "playground/html",
            "--testNamePattern",
            "main preserve comments"
          ]
        }
      },
      "readiness": {
        "type": "process-exit",
        "timeoutMs": 900000
      },
      "expectedCapabilities": ["html"],
      "javascriptApiLevel": "C0",
      "notes": "Imported slice: playground/html/__tests__/html.spec.ts and playground/html/index.html, the fixture that holds the comments asserted by main > preserve comments.",
      "extensions": {
        "x-vite-upstream": {
          "suite": "playground/html",
          "spec": "playground/html/__tests__/html.spec.ts",
          "testName": "main > preserve comments",
          "importedRoot": "playground/html",
          "mode": "serve"
        }
      }
    },
    {
      "id": "actual-budget",
      "kind": "real-project",
      "source": {
        "repository": "https://github.com/actualbudget/actual",
        "commit": "766cc8a7244c35f575ecc33a7a718b060cb5d496",
        "license": {
          "spdxId": "MIT",
          "path": "LICENSE.txt"
        }
      },
      "lockfile": {
        "path": "yarn.lock",
        "packageManager": {
          "name": "yarn",
          "version": "4.17.1"
        }
      },
      "commands": {
        "install": {
          "argv": ["corepack", "yarn", "install", "--immutable"]
        },
        "dev": {
          "argv": ["corepack", "yarn", "start"],
          "env": {
            "BROWSER": "none",
            "PORT": "3001"
          }
        },
        "build": {
          "argv": ["corepack", "yarn", "build:browser"]
        },
        "preview": {
          "argv": ["node", "packages/desktop-client/bin/serve-build.mjs"],
          "env": {
            "BROWSER": "none",
            "PORT": "3001"
          }
        }
      },
      "readiness": {
        "type": "http-ready",
        "urlPath": "/",
        "expectStatus": 200,
        "timeoutMs": 300000
      },
      "browserAcceptance": {
        "entryPath": "/",
        "mainFrameNavigationIsFailure": true,
        "hmr": {
          "sentinelExpression": "globalThis.__rsviteHmrSentinel",
          "sentinelStorage": "in-memory",
          "edit": {
            "path": "packages/desktop-client/src/components/manager/WelcomeScreen.tsx",
            "find": "<Trans>Welcome to Actual</Trans>",
            "replace": "<Trans>Welcome to Actual (rsvite update probe)</Trans>"
          },
          "expectedText": "Welcome to Actual (rsvite update probe)"
        }
      },
      "expectedCapabilities": [
        "html",
        "modules-and-assets",
        "resolution",
        "file-watching",
        "hmr-without-full-reload",
        "build-output"
      ],
      "javascriptApiLevel": "C1",
      "notes": "Complex React monorepo gate. The adapter drives the project's own onboarding E2E spec and build, and changes none of its expectations. The HMR probe edits one source file and restores it after the run. Every fixed input is verified before and after each run, including the ignored translations checkout the production build compiles in.",
      "extensions": {
        "x-actual-budget": {
          "translations": {
            "repository": "https://github.com/actualbudget/translations",
            "commit": "05d15e964dd8a16516d8ba6508ed405554a2e3ec",
            "path": "packages/desktop-client/locale"
          }
        }
      }
    },
    {
      "id": "elk",
      "kind": "real-project",
      "source": {
        "repository": "https://github.com/elk-zone/elk",
        "commit": "ae4ebf3375eb68f1f355390b4f163adb10f5026c",
        "license": {
          "spdxId": "MIT",
          "path": "LICENSE"
        }
      },
      "lockfile": {
        "path": "pnpm-lock.yaml",
        "packageManager": {
          "name": "pnpm",
          "version": "11.6.0"
        }
      },
      "commands": {
        "install": {
          "argv": ["pnpm", "install", "--frozen-lockfile"]
        },
        "dev": {
          "argv": ["pnpm", "dev:mocked"]
        },
        "build": {
          "argv": ["pnpm", "build"]
        },
        "preview": {
          "argv": ["pnpm", "start"]
        }
      },
      "readiness": {
        "type": "stdout-pattern",
        "pattern": "Local:",
        "timeoutMs": 180000
      },
      "browserAcceptance": {
        "entryPath": "/home",
        "mainFrameNavigationIsFailure": true,
        "hmr": {
          "sentinelExpression": "globalThis.__rsviteElkHmrSentinel",
          "sentinelStorage": "in-memory",
          "edit": {
            "path": "app/styles/global.css",
            "find": "  font-size: var(--font-size, 15px);",
            "replace": "  font-size: var(--font-size, 15px); /* rsvite-elk-hmr */"
          },
          "expectedText": "elkdev"
        }
      },
      "expectedCapabilities": [
        "html",
        "modules-and-assets",
        "resolution",
        "errors",
        "file-watching",
        "hmr-without-full-reload",
        "build-output",
        "preview-output",
        "ssr",
        "framework-lifecycle"
      ],
      "javascriptApiLevel": "C3",
      "notes": "Vue/Nuxt JavaScript API and framework-integration gate. ELK source stays external. Original commands: pnpm install --frozen-lockfile, pnpm dev:mocked, pnpm build, pnpm start. Nuxt uses programmatic Vite, vite:extendConfig, client/server resolve aliases, PWA, SSR, prerender, and Nitro packaging. Adapter: @rsvite/compatibility-elk.",
      "extensions": {
        "x-elk": {
          "mockedDev": "dev:mocked",
          "homePath": "/home",
          "exploreHint": "explore",
          "hmrStylesheet": "app/styles/global.css",
          "nuxtHooks": ["vite:extendConfig", "nitro:config", "prepare:types"],
          "buildOutputs": ["client", "ssr", "pwa", "prerender", "nitro"]
        }
      }
    },
    {
      "id": "drawdb",
      "kind": "real-project",
      "source": {
        "repository": "https://github.com/drawdb-io/drawdb",
        "commit": "031aef1f1c1d3f9027ccfacbf084e9c1a31b8abc",
        "license": {
          "spdxId": "AGPL-3.0-only",
          "path": "LICENSE"
        }
      },
      "lockfile": {
        "path": "package-lock.json",
        "packageManager": {
          "name": "npm",
          "version": "11.19.0"
        }
      },
      "commands": {
        "install": {
          "argv": ["npm", "ci"]
        },
        "dev": {
          "argv": ["npm", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5173"]
        },
        "build": {
          "argv": ["npm", "run", "build"]
        },
        "preview": {
          "argv": ["npm", "run", "preview", "--", "--host", "127.0.0.1", "--port", "5173"]
        }
      },
      "readiness": {
        "type": "http-ready",
        "urlPath": "/editor",
        "expectStatus": 200,
        "timeoutMs": 120000
      },
      "browserAcceptance": {
        "entryPath": "/editor",
        "mainFrameNavigationIsFailure": true,
        "hmr": {
          "sentinelExpression": "globalThis.__rsviteDrawDbHmrSentinel",
          "sentinelStorage": "in-memory",
          "edit": {
            "path": "src/index.css",
            "find": "@import \"tailwindcss\";",
            "replace": "@import \"tailwindcss\";\n:root { --rsvite-drawdb-hmr-probe: active; }"
          },
          "expectedText": "Add table"
        }
      },
      "expectedCapabilities": [
        "html",
        "modules-and-assets",
        "resolution",
        "errors",
        "file-watching",
        "hmr-without-full-reload",
        "framework-lifecycle",
        "build-output",
        "preview-output"
      ],
      "javascriptApiLevel": "C2",
      "notes": "Pinned DrawDB baseline. The source is checked out only in a disposable external location; the adapter owns Chromium interaction and HMR observation."
    }
  ]
}
