{
  "contractVersion": 1,
  "entries": [
    {
      "id": "vite-upstream-html-preserve-comments",
      "kind": "vite-upstream-e2e",
      "source": {
        "repository": "https://github.com/vitejs/vite",
        "commit": "ee644014aab61e546742b862a7d7b0d6c7d67a7b",
        "license": {
          "spdxId": "MIT",
          "path": "LICENSE"
        }
      },
      "lockfile": {
        "path": "pnpm-lock.yaml",
        "packageManager": {
          "name": "pnpm",
          "version": "10.34.5"
        }
      },
      "commands": {
        "install": {
          "argv": ["pnpm", "install", "--frozen-lockfile"]
        },
        "test": {
          "argv": [
            "pnpm",
            "test-serve",
            "playground/html",
            "--testNamePattern",
            "main preserve comments"
          ]
        }
      },
      "readiness": {
        "type": "process-exit",
        "timeoutMs": 900000
      },
      "expectedCapabilities": ["html"],
      "javascriptApiLevel": "C0",
      "notes": "Imported slice: playground/html/__tests__/html.spec.ts and playground/html/index.html, the fixture that holds the comments asserted by main > preserve comments.",
      "extensions": {
        "x-vite-upstream": {
          "suite": "playground/html",
          "spec": "playground/html/__tests__/html.spec.ts",
          "testName": "main > preserve comments",
          "importedRoot": "playground/html",
          "mode": "serve"
        }
      }
    },
    {
      "id": "actual-budget",
      "kind": "real-project",
      "source": {
        "repository": "https://github.com/actualbudget/actual",
        "commit": "766cc8a7244c35f575ecc33a7a718b060cb5d496",
        "license": {
          "spdxId": "MIT",
          "path": "LICENSE.txt"
        }
      },
      "lockfile": {
        "path": "yarn.lock",
        "packageManager": {
          "name": "yarn",
          "version": "4.17.1"
        }
      },
      "commands": {
        "install": {
          "argv": ["corepack", "yarn", "install", "--immutable"]
        },
        "dev": {
          "argv": ["corepack", "yarn", "start"],
          "env": {
            "BROWSER": "none",
            "PORT": "3001"
          }
        },
        "build": {
          "argv": ["corepack", "yarn", "build:browser"]
        },
        "preview": {
          "argv": ["node", "packages/desktop-client/bin/serve-build.mjs"],
          "env": {
            "BROWSER": "none",
            "PORT": "3001"
          }
        }
      },
      "readiness": {
        "type": "http-ready",
        "urlPath": "/",
        "expectStatus": 200,
        "timeoutMs": 300000
      },
      "browserAcceptance": {
        "entryPath": "/",
        "mainFrameNavigationIsFailure": true,
        "hmr": {
          "sentinelExpression": "globalThis.__rsviteHmrSentinel",
          "sentinelStorage": "in-memory",
          "edit": {
            "path": "packages/desktop-client/src/components/manager/WelcomeScreen.tsx",
            "find": "<Trans>Welcome to Actual</Trans>",
            "replace": "<Trans>Welcome to Actual (rsvite update probe)</Trans>"
          },
          "expectedText": "Welcome to Actual (rsvite update probe)"
        }
      },
      "expectedCapabilities": [
        "html",
        "modules-and-assets",
        "resolution",
        "file-watching",
        "hmr-without-full-reload",
        "build-output"
      ],
      "javascriptApiLevel": "C1",
      "notes": "Complex React monorepo gate. The adapter drives the project's own onboarding E2E spec and build without modifying its source or expectations."
    }
  ]
}
